@page "/privacy-policy"
@model MonthSpendings.Pages.PrivacyPolicyModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@Model.Language">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Policy.Title — Tavira</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #06101F;
            color: #C8D0DC;
            line-height: 1.7;
            min-height: 100vh;
        }

        header {
            border-bottom: 1px solid rgba(255,255,255,0.06);
            padding: 18px 0;
            position: sticky;
            top: 0;
            background: rgba(6,16,31,0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 10;
        }

        .header-inner {
            max-width: 720px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-dot {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: linear-gradient(135deg, #3EC6C6, #5B7BFF);
            flex-shrink: 0;
        }

        .brand-name {
            font-size: 17px;
            font-weight: 700;
            color: #F2F4F8;
            letter-spacing: -0.3px;
        }

        main {
            max-width: 720px;
            margin: 0 auto;
            padding: 56px 24px 80px;
        }

        .page-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #3EC6C6;
            margin-bottom: 12px;
        }

        h1 {
            font-size: clamp(26px, 5vw, 36px);
            font-weight: 800;
            color: #F2F4F8;
            letter-spacing: -0.8px;
            line-height: 1.2;
            margin-bottom: 10px;
        }

        .meta {
            font-size: 12px;
            color: rgba(242,244,248,0.28);
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-bottom: 24px;
        }

        .intro {
            font-size: 15px;
            color: rgba(242,244,248,0.55);
            line-height: 1.8;
            margin-bottom: 48px;
            padding-bottom: 32px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .notice {
            font-size: 13px;
            color: rgba(242,244,248,0.45);
            border-left: 2px solid #3EC6C6;
            padding-left: 12px;
            margin-bottom: 20px;
        }

        .sections {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .section {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 14px;
            padding: 22px 24px;
            transition: border-color 0.2s;
        }

        .section:hover {
            border-color: rgba(91,123,255,0.22);
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
        }

        .accent-bar {
            width: 3px;
            height: 16px;
            border-radius: 2px;
            background: #5B7BFF;
            flex-shrink: 0;
        }

        .section-index {
            font-size: 10px;
            font-weight: 700;
            color: rgba(91,123,255,0.45);
            letter-spacing: 0.5px;
            flex-shrink: 0;
        }

        .section-title {
            font-size: 11px;
            font-weight: 700;
            color: #5B7BFF;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }

        .section-body {
            font-size: 14px;
            color: rgba(242,244,248,0.58);
            line-height: 1.75;
        }

        footer {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding: 32px 0;
            text-align: center;
        }

        .footer-inner {
            max-width: 720px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .footer-text {
            font-size: 12px;
            color: rgba(242,244,248,0.22);
        }

        .footer-link {
            color: rgba(62,198,198,0.6);
            text-decoration: none;
        }

        .footer-link:hover {
            color: #3EC6C6;
        }

        @@media (max-width: 480px) {
            main { padding: 40px 16px 60px; }
            .section { padding: 18px 16px; }
        }
    </style>
</head>
<body>
    @{
        var c = Model.Policy;
        const string emailLink = "<a class=\"footer-link\" href=\"mailto:support@tavira.com\">support&commat;tavira.com</a>";
    }
    <header>
        <div class="header-inner">
            <div class="brand-dot"></div>
            <span class="brand-name">Tavira</span>
        </div>
    </header>

    <main>
        <p class="page-label">@c.Label</p>
        <h1>@c.Title</h1>
        <p class="meta">@c.LastUpdated</p>
        @if (c.TranslationNotice is not null)
        {
            <p class="notice">@c.TranslationNotice</p>
        }
        <p class="intro">@c.Intro</p>

        <div class="sections">
            @for (int i = 0; i < c.Sections.Length; i++)
            {
                var item = c.Sections[i];
                <div class="section">
                    <div class="section-header">
                        <div class="accent-bar"></div>
                        <span class="section-index">@((i + 1).ToString("00"))</span>
                        <span class="section-title">@item.Title</span>
                    </div>
                    <p class="section-body">
                        @Html.Raw(System.Net.WebUtility.HtmlEncode(item.Body).Replace("{email}", emailLink))
                    </p>
                </div>
            }
        </div>
    </main>

    <footer>
        <div class="footer-inner">
            <p class="footer-text">
                &copy; 2025 Tavira. @c.FooterRights &middot;
                <a class="footer-link" href="mailto:support@tavira.com">@c.FooterContact</a>
            </p>
        </div>
    </footer>
</body>
</html>
